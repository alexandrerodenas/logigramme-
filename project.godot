; Engine configuration file.

config_version=5

[application]

config/name="Logigramme"
config/description="Jeu de logigrammes jouable hors ligne."
config/version="2.4.1"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=3
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(1, 0.972549, 0.92549, 1)
